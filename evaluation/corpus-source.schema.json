{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/evaluation/corpus-source.schema.json",
  "title": "Koguard external corpus source pin",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_name", "repository", "revision", "artifact", "license", "format", "intake"],
  "properties": {
    "schema_version": {"const": 2},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "source_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "repository": {"type": "string", "format": "uri"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "artifact": {"$ref": "#/$defs/artifact"},
    "license": {"$ref": "#/$defs/license"},
    "format": {"$ref": "#/$defs/format"},
    "intake": {"$ref": "#/$defs/intake"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size_bytes", "line_count"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "line_count": {"type": "integer", "minimum": 1}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "url", "sha256", "redistribution_allowed"],
      "properties": {
        "spdx": {"enum": ["MIT", "Apache-2.0", "CC-BY-4.0", "CC-BY-SA-4.0"]},
        "url": {"type": "string", "format": "uri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "redistribution_allowed": {"const": true}
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "delimiter", "encoding", "header_rows", "text_column", "label_column", "allowed_labels"],
      "properties": {
        "kind": {"const": "delimited"},
        "delimiter": {"enum": ["|", "\t", ","]},
        "encoding": {"const": "utf-8"},
        "header_rows": {"enum": [0, 1]},
        "text_column": {"type": "integer", "minimum": 0},
        "label_column": {"type": ["integer", "null"], "minimum": -1},
        "allowed_labels": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"label_column": {"type": "null"}}, "required": ["label_column"]},
          "then": {"properties": {"allowed_labels": {"type": "null"}}},
          "else": {"properties": {"allowed_labels": {"type": "array"}}}
        }
      ]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "split", "selection", "target_count", "target_by_source_label"],
      "properties": {
        "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "split": {"const": "tuning"},
        "selection": {"const": "stable-sha256-rank-v1"},
        "target_count": {"type": ["integer", "null"], "minimum": 1},
        "target_by_source_label": {
          "type": ["object", "null"],
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "oneOf": [
        {
          "properties": {
            "target_count": {"type": "integer"},
            "target_by_source_label": {"type": "null"}
          }
        },
        {
          "properties": {
            "target_count": {"type": "null"},
            "target_by_source_label": {"type": "object"}
          }
        }
      ]
    }
  }
}
