{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/evaluation/review-buffer.schema.json",
  "title": "Koguard incremental review buffer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "buffer_id",
    "corpus_id",
    "split",
    "selection",
    "max_source_share",
    "selection_uses_upstream_labels_for_targeting",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "buffer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "corpus_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "split": {"const": "tuning"},
    "selection": {"const": "incremental-source-sha256-v1"},
    "max_source_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "selection_uses_upstream_labels_for_targeting": {"const": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "corpus_path",
        "expected_corpus_id",
        "existing_corpus_path",
        "expected_existing_corpus_id",
        "quota"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "corpus_path": {"type": "string", "minLength": 1},
        "expected_corpus_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "existing_corpus_path": {"type": "string", "minLength": 1},
        "expected_existing_corpus_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "quota": {"type": "integer", "minimum": 1}
      }
    }
  }
}
