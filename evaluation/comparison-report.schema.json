{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/evaluation/comparison-report.schema.json",
  "title": "Koguard detector comparison report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "corpus",
    "runner",
    "detectors",
    "case_results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "runner": {"$ref": "#/$defs/runner"},
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/detectorReport"}
    },
    "case_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/caseResult"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "files",
        "case_count",
        "evaluated_case_count",
        "excluded_review_count"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["corpus_id", "sha256"],
            "properties": {
              "corpus_id": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "case_count": {"type": "integer", "minimum": 1},
        "evaluated_case_count": {"type": "integer", "minimum": 0},
        "excluded_review_count": {"type": "integer", "minimum": 0}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "python_version",
        "implementation",
        "platform",
        "configuration_sha256"
      ],
      "properties": {
        "name": {"const": "koguard-comparison-runner"},
        "version": {"type": "string"},
        "python_version": {"type": "string"},
        "implementation": {"type": "string"},
        "platform": {"type": "string"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "filename", "sha256", "size_bytes"],
      "properties": {
        "package": {"type": "string"},
        "version": {"type": "string"},
        "filename": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence", "occurrences", "spans", "canonical_terms"],
      "properties": {
        "sentence": {"type": "boolean"},
        "occurrences": {"type": "boolean"},
        "spans": {"type": "boolean"},
        "canonical_terms": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "implementation",
        "platform",
        "dependencies",
        "suppressed_output"
      ],
      "properties": {
        "python_version": {"type": "string"},
        "implementation": {"type": "string"},
        "platform": {"type": "string"},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "version"],
            "properties": {
              "package": {"type": "string"},
              "version": {"type": "string"}
            }
          }
        },
        "suppressed_output": {"type": "boolean"}
      }
    },
    "sentenceCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tp", "fp", "fn", "tn"],
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0},
        "tn": {"type": "integer", "minimum": 0}
      }
    },
    "occurrenceCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tp", "fp", "fn"],
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0}
      }
    },
    "sentenceMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "precision", "recall", "f1", "accuracy"],
      "properties": {
        "counts": {"$ref": "#/$defs/sentenceCounts"},
        "precision": {"$ref": "#/$defs/rate"},
        "recall": {"$ref": "#/$defs/rate"},
        "f1": {"$ref": "#/$defs/rate"},
        "accuracy": {"$ref": "#/$defs/rate"}
      }
    },
    "occurrenceMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "precision", "recall", "f1"],
      "properties": {
        "counts": {"$ref": "#/$defs/occurrenceCounts"},
        "precision": {"$ref": "#/$defs/rate"},
        "recall": {"$ref": "#/$defs/rate"},
        "f1": {"$ref": "#/$defs/rate"}
      }
    },
    "occurrenceMetrics": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unsupported"},
            "reason": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exact", "span", "canonical"],
          "properties": {
            "status": {"const": "available"},
            "exact": {"$ref": "#/$defs/occurrenceMetric"},
            "span": {"$ref": "#/$defs/occurrenceMetric"},
            "canonical": {"$ref": "#/$defs/occurrenceMetric"}
          }
        }
      ]
    },
    "sliceMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice", "case_count", "sentence_metrics", "occurrence_metrics"],
      "properties": {
        "slice": {"type": "string"},
        "case_count": {"type": "integer", "minimum": 1},
        "sentence_metrics": {"$ref": "#/$defs/sentenceMetric"},
        "occurrence_metrics": {"$ref": "#/$defs/occurrenceMetrics"}
      }
    },
    "detectorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_id",
        "artifact",
        "profile",
        "settings",
        "capabilities",
        "runtime",
        "sentence_metrics",
        "occurrence_metrics",
        "slice_metrics",
        "limitations"
      ],
      "properties": {
        "detector_id": {"type": "string"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "profile": {"type": "string"},
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "integer", "number"]
          }
        },
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "runtime": {"$ref": "#/$defs/runtime"},
        "sentence_metrics": {"$ref": "#/$defs/sentenceMetric"},
        "occurrence_metrics": {"$ref": "#/$defs/occurrenceMetrics"},
        "slice_metrics": {
          "type": "array",
          "items": {"$ref": "#/$defs/sliceMetric"}
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "detectorCaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_id",
        "detected",
        "sentence_outcome",
        "predicted_occurrence_count"
      ],
      "properties": {
        "detector_id": {"type": "string"},
        "detected": {"type": "boolean"},
        "sentence_outcome": {"enum": ["tp", "fp", "fn", "tn"]},
        "predicted_occurrence_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "label",
        "slices",
        "gold_detected",
        "gold_occurrence_count",
        "detectors"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "label": {"enum": ["positive", "hard-negative"]},
        "slices": {"type": "array", "items": {"type": "string"}},
        "gold_detected": {"type": "boolean"},
        "gold_occurrence_count": {"type": "integer", "minimum": 0},
        "detectors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/detectorCaseResult"}
        }
      }
    }
  }
}
