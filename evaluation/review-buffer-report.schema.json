{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/evaluation/review-buffer-report.schema.json",
  "title": "Koguard incremental review buffer report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "buffer_id",
    "corpus_id",
    "selection",
    "selected_count",
    "configured_max_source_share",
    "maximum_observed_source_share",
    "source_bias_gate_passed",
    "source_statistics",
    "selection_uses_upstream_labels_for_targeting",
    "upstream_labels_are_gold",
    "generated_label_counts",
    "selected_existing_overlap_count",
    "gold_ready",
    "completion_blockers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "buffer_id": {"type": "string"},
    "corpus_id": {"type": "string"},
    "selection": {"const": "incremental-source-sha256-v1"},
    "selected_count": {"type": "integer", "minimum": 1},
    "configured_max_source_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maximum_observed_source_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "source_bias_gate_passed": {"const": true},
    "source_statistics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "available_count",
          "existing_excluded_count",
          "duplicate_excluded_count",
          "eligible_count",
          "selected_count",
          "share"
        ],
        "properties": {
          "source_id": {"type": "string"},
          "available_count": {"type": "integer", "minimum": 1},
          "existing_excluded_count": {"type": "integer", "minimum": 0},
          "duplicate_excluded_count": {"type": "integer", "minimum": 0},
          "eligible_count": {"type": "integer", "minimum": 1},
          "selected_count": {"type": "integer", "minimum": 1},
          "share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    },
    "selection_uses_upstream_labels_for_targeting": {"const": true},
    "upstream_labels_are_gold": {"const": false},
    "generated_label_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "hard-negative", "review"],
      "properties": {
        "positive": {"const": 0},
        "hard-negative": {"const": 0},
        "review": {"type": "integer", "minimum": 1}
      }
    },
    "selected_existing_overlap_count": {"const": 0},
    "gold_ready": {"const": false},
    "completion_blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
