{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/release/artifact-audit.schema.json",
  "title": "Koguard release artifact audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "environment", "package", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_commit", "git_tree"],
      "properties": {
        "release_commit": {"$ref": "#/$defs/gitOid"},
        "git_tree": {"$ref": "#/$defs/gitOid"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "implementation", "platform"],
      "properties": {
        "python_version": {"const": "3.11.9"},
        "implementation": {"const": "CPython"},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "package": {"$ref": "#/$defs/package"},
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/wheel"},
        {"$ref": "#/$defs/sdist"}
      ],
      "items": false
    }
  },
  "$defs": {
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "requires_python", "license_expression", "runtime_dependencies"],
      "properties": {
        "name": {"const": "koguard"},
        "version": {"const": "0.1.0"},
        "requires_python": {"const": ">=3.11,<3.12"},
        "license_expression": {"const": "MIT"},
        "runtime_dependencies": {"const": []}
      }
    },
    "baseArtifact": {
      "type": "object",
      "required": ["kind", "filename", "size_bytes", "sha256"],
      "properties": {
        "kind": {"enum": ["wheel", "sdist"]},
        "filename": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sdist": {
      "allOf": [
        {"$ref": "#/$defs/baseArtifact"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "filename", "size_bytes", "sha256", "member_count", "release_evidence"],
          "properties": {
            "kind": {"const": "sdist"},
            "filename": {"const": "koguard-0.1.0.tar.gz"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "member_count": {"type": "integer", "minimum": 1},
            "release_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      ]
    },
    "wheel": {
      "allOf": [
        {"$ref": "#/$defs/baseArtifact"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "filename", "size_bytes", "sha256", "member_count", "bundled_notices"],
          "properties": {
            "kind": {"const": "wheel"},
            "filename": {"const": "koguard-0.1.0-py3-none-any.whl"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "member_count": {"type": "integer", "minimum": 1},
            "bundled_notices": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      ]
    }
  }
}
