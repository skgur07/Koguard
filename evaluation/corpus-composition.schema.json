{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/evaluation/corpus-composition.schema.json",
  "title": "Koguard multi-source review composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "composition_id", "corpus_id", "split", "selection", "max_source_share", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "composition_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "corpus_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "split": {"const": "tuning"},
    "selection": {"const": "stable-sha256-rank-v1"},
    "max_source_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "corpus_path", "expected_corpus_id", "quota"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "corpus_path": {"type": "string", "minLength": 1},
        "expected_corpus_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "quota": {"type": "integer", "minimum": 1}
      }
    }
  }
}
