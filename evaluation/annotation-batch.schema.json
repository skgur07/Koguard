{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skgur07/Koguard/blob/dev/evaluation/annotation-batch.schema.json",
  "title": "Koguard blinded annotation batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_set_id",
    "reviewer_id",
    "corpus_id",
    "corpus_sha256",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "annotation_set_id": {"$ref": "#/$defs/id"},
    "reviewer_id": {"$ref": "#/$defs/id"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "expectedMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "canonical_term"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "canonical_term": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "text",
        "privacy_status",
        "label",
        "expected_matches",
        "slices",
        "notes"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "maxLength": 4096},
        "privacy_status": {"enum": ["pending", "approved", "exclude"]},
        "label": {"enum": ["positive", "hard-negative", "review"]},
        "expected_matches": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/expectedMatch"}
        },
        "slices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "corpus.schema.json#/$defs/case/properties/slices/items"}
        },
        "notes": {"type": "string", "maxLength": 500}
      },
      "allOf": [
        {
          "if": {"properties": {"label": {"const": "positive"}}, "required": ["label"]},
          "then": {"properties": {"expected_matches": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {"label": {"enum": ["hard-negative", "review"]}},
            "required": ["label"]
          },
          "then": {"properties": {"expected_matches": {"maxItems": 0}}}
        },
        {
          "if": {
            "properties": {"privacy_status": {"enum": ["pending", "exclude"]}},
            "required": ["privacy_status"]
          },
          "then": {
            "properties": {
              "label": {"const": "review"},
              "expected_matches": {"maxItems": 0},
              "slices": {"const": ["unadjudicated-intake"]}
            }
          }
        }
      ]
    }
  }
}
